{
  "grammar": {
    "terminals": [
      "x",
      "*",
      "="
    ],
    "nonTerminals": [
      "S",
      "L",
      "R"
    ],
    "rules": [
      {
        "left": "S",
        "right": "L=R"
      },
      {
        "left": "S",
        "right": "R"
      },
      {
        "left": "L",
        "right": "*R"
      },
      {
        "left": "L",
        "right": "x"
      },
      {
        "left": "R",
        "right": "L"
      }
    ],
    "startSymbol": "S"
  },
  "buildOptions": {
    "enableBuildLog":true
  }
}